<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme Colors -->
    <Color x:Key="BackgroundColor">#202020</Color>
    <Color x:Key="SurfaceColor">#2D2D2D</Color>
    <Color x:Key="BorderColor">#3D3D3D</Color>
    <Color x:Key="TextPrimaryColor">#F3F3F3</Color>
    <Color x:Key="TextSecondaryColor">#ABABAB</Color>
    <Color x:Key="NavBackgroundColor">#2D2D2D</Color>
    <Color x:Key="NavSelectedColor">#1A3A52</Color>
    <Color x:Key="NavSelectedBorderColor">#0078D4</Color>
    <Color x:Key="NavHoverColor">#383838</Color>
    <Color x:Key="OverlayBackgroundColor">#B0000000</Color>
    <Color x:Key="LoadingCardColor">#2D2D2D</Color>

    <!-- Dark Theme Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush"     Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush"        Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="BorderBrush"         Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush"    Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"  Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="NavBackgroundBrush"  Color="{StaticResource NavBackgroundColor}"/>
    <SolidColorBrush x:Key="NavSelectedBrush"    Color="{StaticResource NavSelectedColor}"/>
    <SolidColorBrush x:Key="NavHoverBrush"       Color="{StaticResource NavHoverColor}"/>
    <SolidColorBrush x:Key="LoadingCardBrush"    Color="{StaticResource LoadingCardColor}"/>

</ResourceDictionary>
